# Turns the AR-1 base floorplans (base_designs/floorplan/<platform>/<design>/
# 60/ar1.odb: ORFS synthesis netlist, debuffered, square die at 60 %
# utilization, macros placed by RTL-MP and FIXED with 10 um soft-blockage
# halos and 2 um row cuts, I/O pins placed and FIXED, standard cells
# UNPLACED, no SDC) into harness checkpoints
# bench/designs/<design>_ar1_<platform>/{floorplan.db -> the .odb,
# design.sdc, vars.tcl}, so that exp/run.sh, bench/mincut.tcl,
# bench/capo.tcl and bench/gpl_baseline.tcl run on them unchanged.
#
#   MCP_BASE_PLATFORM=nangate45 MCP_BASE_DESIGN=aes \
#     openroad -exit bench/make_base_checkpoints.tcl
#
# One process per (platform, design): the .odb is read to find the top
# module and the clock port (the SDC is just that clock; timing is not
# reported on these floorplans).  ng45/ in base_designs is a byte-identical
# copy of nangate45/ and is not used.
#
# Platform settings come from OpenROAD/test (Nangate45/, asap7/); the
# placement settings reproduce the flow that made the floorplans: target
# density 0.70 (what its global_placement used), no cell padding (gpl, mcp
# and Capo alike), no detail-placement padding.

source [file join [file dirname [file normalize [info script]]] common.tcl]

set platform [mcp_env MCP_BASE_PLATFORM ""]
set design [mcp_env MCP_BASE_DESIGN ""]
set src_root [mcp_env MCP_BASE_ROOT \
  [file join $::mcp_root_dir base_designs floorplan]]
set util [mcp_env MCP_BASE_UTIL 60]
if { $platform == "" || $design == "" } {
  puts "MCP_BASE_PLATFORM and MCP_BASE_DESIGN must be set"
  exit 1
}

set t [file join $::mcp_or_test_dir]
switch -- $platform {
  nangate45 {
    set vars [dict create \
      site FreePDK45_38x28_10R_NP_162NW_34O \
      wire_rc_layer metal3 wire_rc_layer_clk metal6 \
      global_routing_layers metal2-metal10 \
      global_routing_clock_layers metal6-metal10 \
      global_routing_layer_adjustments {{{metal2-metal10} 0.5}} \
      dont_use {CLKBUF_* AOI211_X1 OAI211_X1} \
      liberty_file [list [file join $t Nangate45 Nangate45_typ.lib]] \
      extra_liberty {} \
      layer_rc_file [list [file join $t Nangate45 Nangate45.rc]]]
    set clock_period 10.0
  }
  asap7 {
    set vars [dict create \
      site asap7sc7p5t \
      wire_rc_layer M3 wire_rc_layer_clk M6 \
      global_routing_layers M2-M6 \
      global_routing_clock_layers M4-M6 \
      global_routing_layer_adjustments {{{M2-M7} 0.25}} \
      dont_use {*x1p*_ASAP7* *xp*_ASAP7* SDF* ICG*} \
      liberty_file [list [file join $t asap7 asap7sc7p5t_AO_RVT_FF_nldm_211120.lib.gz]] \
      extra_liberty [list \
        [file join $t asap7 asap7sc7p5t_INVBUF_RVT_FF_nldm_220122.lib.gz] \
        [file join $t asap7 asap7sc7p5t_OA_RVT_FF_nldm_211120.lib.gz] \
        [file join $t asap7 asap7sc7p5t_SIMPLE_RVT_FF_nldm_211120.lib.gz] \
        [file join $t asap7 asap7sc7p5t_SEQ_RVT_FF_nldm_220123.lib]] \
      layer_rc_file [list [file join $t asap7 setRC.tcl]]]
    set clock_period 1000 ;# ps
  }
  default {
    puts "unknown platform $platform"
    exit 1
  }
}

set odb [file join $src_root $platform $design $util ar1.odb]
if { ![file exists $odb] } {
  puts "missing $odb"
  exit 1
}
read_db $odb
set block [ord::get_db_block]
set top [$block getName]
set clock_port ""
foreach b [$block getBTerms] {
  set n [$b getName]
  if { $n == "clk" || $n == "clk_i" || $n == "clock" } { set clock_port $n; break }
}
if { $clock_port == "" } {
  foreach b [$block getBTerms] {
    if { [string match -nocase *clk* [$b getName]] && [$b getIoType] == "INPUT" } {
      set clock_port [$b getName]
      break
    }
  }
}
set n_macros 0
set n_fixed 0
foreach inst [$block getInsts] {
  if { [$inst isFixed] } {
    incr n_fixed
    if { [[$inst getMaster] isBlock] } { incr n_macros }
  }
}
set n_soft 0
set n_hard 0
foreach bl [$block getBlockages] {
  if { [$bl isSoft] } { incr n_soft } else { incr n_hard }
}
puts "$platform/$design: top $top, [llength [$block getInsts]] instances,\
  $n_macros macros ($n_fixed fixed), $n_soft soft / $n_hard hard blockages,\
  [llength [$block getRows]] rows, clock port '$clock_port'"

set name "${design}_ar1_${platform}"
set dir [file join $::mcp_bench_dir designs $name]
file mkdir $dir
set link [file join $dir floorplan.db]
file delete -force $link
file link -symbolic $link $odb

set f [open [file join $dir design.sdc] w]
if { $clock_port != "" } {
  puts $f "create_clock -name core_clock -period $clock_period \[get_ports $clock_port\]"
}
close $f

set f [open [file join $dir vars.tcl] w]
puts $f "# generated by bench/make_base_checkpoints.tcl from $odb"
puts $f "set platform $platform"
puts $f "set design $design"
puts $f "set top_module $top"
puts $f "set base_util $util"
puts $f "set base_macros $n_macros"
dict for {k v} $vars {
  puts $f "set $k [list $v]"
}
puts $f "set global_place_density 0.70"
puts $f "set global_place_pad 0"
puts $f "set detail_place_pad 0"
puts $f "set macro_place_halo {0 0}"
puts $f "set sdc_file [list [file join $dir design.sdc]]"
close $f
puts "wrote $dir"
exit
