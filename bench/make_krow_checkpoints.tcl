# Turns the k-row floorplans (k-row-floorplans/floorplan/<platform>/<design>/
# <util>/<rows>.odb: unplaced standard cells, I/O pins placed on the bottom
# edge, 1/2/4/6/8 rows at 60/70/80 % utilization, no taps, no PDN, no SDC)
# into harness checkpoints bench/designs/<design>_u<util>_r<rows>_<platform>/
# {floorplan.db -> the .odb, design.sdc, vars.tcl}, so that exp/run.sh,
# bench/mincut.tcl, bench/capo.tcl and bench/gpl_baseline.tcl run on them
# unchanged.
#
#   MCP_KROW_PLATFORM=nangate45 MCP_KROW_DESIGN=gcd \
#     openroad -exit bench/make_krow_checkpoints.tcl
#
# One process per (platform, design): the first .odb is read to find the
# clock port (the SDC is just that clock; timing is not reported on these
# floorplans), the 15 checkpoint directories are then written.
#
# Platform settings come from OpenROAD/test (Nangate45/, asap7/asap7.vars);
# the placement settings reproduce the flow that made the floorplans:
# target density 0.70 / 0.71 / 0.81 at 60 / 70 / 80 % (what its
# global_placement used), no cell padding (gpl, mcp and Capo alike) and no
# detail-placement padding (at 80 % there is no room for it).

source [file join [file dirname [file normalize [info script]]] common.tcl]

set platform [mcp_env MCP_KROW_PLATFORM ""]
set design [mcp_env MCP_KROW_DESIGN ""]
set src_root [mcp_env MCP_KROW_ROOT \
  [file join $::mcp_root_dir k-row-floorplans floorplan]]
if { $platform == "" || $design == "" } {
  puts "MCP_KROW_PLATFORM and MCP_KROW_DESIGN must be set"
  exit 1
}
set utils [mcp_env MCP_KROW_UTILS "60 70 80"]
set rows_list [mcp_env MCP_KROW_ROWS "1 2 4 6 8"]

set t [file join $::mcp_or_test_dir]
switch -- $platform {
  nangate45 {
    set vars [dict create \
      site FreePDK45_38x28_10R_NP_162NW_34O \
      wire_rc_layer metal3 wire_rc_layer_clk metal6 \
      global_routing_layers metal2-metal10 \
      global_routing_clock_layers metal6-metal10 \
      global_routing_layer_adjustments {{{metal2-metal10} 0.5}} \
      dont_use {CLKBUF_* AOI211_X1 OAI211_X1} \
      liberty_file [list [file join $t Nangate45 Nangate45_typ.lib]] \
      extra_liberty {} \
      layer_rc_file [list [file join $t Nangate45 Nangate45.rc]]]
    set clock_period 10.0
  }
  asap7 {
    set vars [dict create \
      site asap7sc7p5t \
      wire_rc_layer M3 wire_rc_layer_clk M6 \
      global_routing_layers M2-M6 \
      global_routing_clock_layers M4-M6 \
      global_routing_layer_adjustments {{{M2-M7} 0.25}} \
      dont_use {*x1p*_ASAP7* *xp*_ASAP7* SDF* ICG*} \
      liberty_file [list [file join $t asap7 asap7sc7p5t_AO_RVT_FF_nldm_211120.lib.gz]] \
      extra_liberty [list \
        [file join $t asap7 asap7sc7p5t_INVBUF_RVT_FF_nldm_220122.lib.gz] \
        [file join $t asap7 asap7sc7p5t_OA_RVT_FF_nldm_211120.lib.gz] \
        [file join $t asap7 asap7sc7p5t_SIMPLE_RVT_FF_nldm_211120.lib.gz] \
        [file join $t asap7 asap7sc7p5t_SEQ_RVT_FF_nldm_220123.lib]] \
      layer_rc_file [list [file join $t asap7 setRC.tcl]]]
    set clock_period 1000 ;# ps
  }
  default {
    puts "unknown platform $platform"
    exit 1
  }
}

# Clock port from the first floorplan.
set first [file join $src_root $platform $design [lindex $utils 0] \
  "[lindex $rows_list 0].odb"]
read_db $first
set block [ord::get_db_block]
set top [$block getName]
set clock_port ""
foreach b [$block getBTerms] {
  set n [$b getName]
  if { $n == "clk" || $n == "clk_i" || $n == "clock" } { set clock_port $n; break }
}
if { $clock_port == "" } {
  foreach b [$block getBTerms] {
    if { [string match -nocase *clk* [$b getName]] && [$b getIoType] == "INPUT" } {
      set clock_port [$b getName]
      break
    }
  }
}
puts "$platform/$design: top $top, [llength [$block getInsts]] instances, clock port '$clock_port'"

foreach util $utils {
  foreach rows $rows_list {
    set odb [file join $src_root $platform $design $util "$rows.odb"]
    if { ![file exists $odb] } {
      puts "missing $odb"
      continue
    }
    set name "${design}_u${util}_r${rows}_${platform}"
    set dir [file join $::mcp_bench_dir designs $name]
    file mkdir $dir
    set link [file join $dir floorplan.db]
    file delete -force $link
    file link -symbolic $link $odb

    set f [open [file join $dir design.sdc] w]
    if { $clock_port != "" } {
      puts $f "create_clock -name core_clock -period $clock_period \[get_ports $clock_port\]"
    }
    close $f

    # The flow that made the floorplans: 0.70 at 60 %, util + 0.01 above.
    set density [expr { max(0.70, $util / 100.0 + 0.01) }]
    set f [open [file join $dir vars.tcl] w]
    puts $f "# generated by bench/make_krow_checkpoints.tcl from $odb"
    puts $f "set platform $platform"
    puts $f "set design $design"
    puts $f "set top_module $top"
    puts $f "set krow_util $util"
    puts $f "set krow_rows $rows"
    dict for {k v} $vars {
      puts $f "set $k [list $v]"
    }
    puts $f "set global_place_density [format %.2f $density]"
    puts $f "set global_place_pad 0"
    puts $f "set detail_place_pad 0"
    puts $f "set macro_place_halo {0 0}"
    puts $f "set sdc_file [list [file join $dir design.sdc]]"
    close $f
    puts "wrote $dir (density $density)"
  }
}
exit
