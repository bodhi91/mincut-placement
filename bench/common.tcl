# Shared procedures of the benchmark harness.  Sourced by
# make_checkpoints.tcl, eval.tcl, gpl_baseline.tcl and exp/run.tcl.
#
# A design checkpoint lives in bench/designs/<design>_<platform>/:
#   floorplan.db   floorplan, macros, taps, PDN, placed pins; std cells unplaced
#   design.sdc     constraints
#   vars.tcl       platform variables with absolute paths (see mcp_write_vars)

set ::mcp_bench_dir [file dirname [file normalize [info script]]]
set ::mcp_root_dir [file dirname $::mcp_bench_dir]
set ::mcp_or_test_dir [file join $::mcp_root_dir OpenROAD test]

proc mcp_env { name default } {
  if { [info exists ::env($name)] && $::env($name) != "" } {
    return $::env($name)
  }
  return $default
}

proc mcp_design_dir { design } {
  return [file join $::mcp_bench_dir designs $design]
}

# Variables of the OpenROAD test flow that the evaluation needs after the
# checkpoint has been written.  Paths are made absolute.
set ::mcp_path_vars {liberty_file extra_liberty layer_rc_file sdc_file}
set ::mcp_plain_vars {
  platform design top_module site
  wire_rc_layer wire_rc_layer_clk
  global_routing_layers global_routing_clock_layers
  global_routing_layer_adjustments
  global_place_density global_place_pad detail_place_pad
  dont_use macro_place_halo
}

proc mcp_write_vars { file } {
  set out [open $file w]
  puts $out "# generated by bench/make_checkpoints.tcl"
  foreach v $::mcp_plain_vars {
    if { [info exists ::$v] } {
      puts $out "set $v [list [set ::$v]]"
    }
  }
  foreach v $::mcp_path_vars {
    if { [info exists ::$v] } {
      set paths {}
      foreach p [set ::$v] {
        lappend paths [file normalize [file join $::mcp_or_test_dir $p]]
      }
      puts $out "set $v [list $paths]"
    }
  }
  close $out
}

# Loads a checkpoint with liberty and constraints so that timing and
# routing commands work.
#
# Technology-less checkpoints (the ICCAD04 Bookshelf benchmarks from
# bench/make_iccad04_checkpoints.tcl: no liberty, SDC, wire RC or routing
# layers) set liberty_file {} in vars.tcl; only the database is read, and
# the evaluation must run with MCP_NO_ROUTE=1.
proc mcp_load_design { design } {
  set dir [mcp_design_dir $design]
  uplevel #0 [list source [file join $dir vars.tcl]]
  set techless [expr { [llength [concat $::liberty_file $::extra_liberty]] == 0 }]
  foreach lib [concat $::liberty_file $::extra_liberty] {
    read_liberty $lib
  }
  read_db [file join $dir floorplan.db]
  if { $techless } {
    puts "$design: technology-less checkpoint (no liberty / SDC / routing)"
    return
  }
  read_sdc [file join $dir design.sdc]
  uplevel #0 [list source $::layer_rc_file]
  set_wire_rc -signal -layer $::wire_rc_layer
  set_wire_rc -clock -layer $::wire_rc_layer_clk
  set_dont_use $::dont_use
}

# Timing-driven net weights for mincut_placement -net_weights_file (E25,
# arm 6).  Static timing with ideal wires (nothing is placed yet, so no
# parasitics): every net gets the setup slack of its driver pin; its
# criticality is c = clamp(1 - slack / T, 0, 1) with T the shortest
# clock period, and the weight 1 + gain * c (default gain 4: a net at
# zero or negative slack weighs 5, one with a full period of slack 1).
# Writes "net_name weight" for every net with weight > 1.001 and returns
# the number of nets written.
proc mcp_timing_weights { file {gain 4.0} } {
  set period 0.0
  foreach clk [all_clocks] {
    set p [get_property $clk period]
    if { $period == 0.0 || $p < $period } {
      set period $p
    }
  }
  if { $period <= 0.0 } {
    puts "mcp_timing_weights: no clock; no weights written"
    close [open $file w]
    return 0
  }
  # Pass 1: driver-pin setup slack per net (clock-network nets skipped;
  # CTS owns them).
  set block [ord::get_db_block]
  set slacks {}
  set wns 1e30
  foreach net [$block getNets] {
    if { [$net getSigType] != "SIGNAL" } {
      continue
    }
    set snet [sta::db_net_to_sta $net]
    if { $snet == "NULL" } {
      continue
    }
    set slack 1e30
    set is_clock 0
    foreach pin [sta::net_driver_pins $snet] {
      if { [llength [get_property $pin clocks]] > 0 } {
        set is_clock 1
        break
      }
      set s [get_property $pin slack_max]
      if { $s < $slack } {
        set slack $s
      }
    }
    if { $is_clock || $slack >= 1e29 } {
      continue
    }
    if { $slack < $wns } {
      set wns $slack
    }
    lappend slacks [$net getName] $slack
  }
  # Pass 2: criticality c = (T - slack) / (T - WNS), so a net with a full
  # period of slack is uncritical (c = 0) and the worst net gets c = 1
  # whether or not the constraint is met.  Weight = 1 + gain * c.
  set span [expr {$period - $wns}]
  set out [open $file w]
  puts $out "# timing weights: 1 + $gain * clamp(($period - slack) / ($period - $wns), 0, 1)"
  set n 0
  if { $span > 0.0 } {
    foreach {name slack} $slacks {
      set c [expr {($period - $slack) / $span}]
      if { $c > 1.0 } { set c 1.0 }
      if { $c <= 0.0 } { continue }
      set w [expr {1.0 + $gain * $c}]
      if { $w > 1.001 } {
        puts $out "$name [format %.4f $w]"
        incr n
      }
    }
  }
  close $out
  puts "mcp_timing_weights: $n of [expr {[llength $slacks] / 2}] nets weighted (period $period, WNS $wns)"
  return $n
}

# Unplaces every movable standard cell (keeps FIRM/LOCKED cells and
# placed macros).
proc mcp_unplace_std_cells { } {
  set block [ord::get_db_block]
  set n 0
  foreach inst [$block getInsts] {
    if { [$inst isFixed] } {
      continue
    }
    if { [[$inst getMaster] isBlock] } {
      continue
    }
    if { ![[$inst getMaster] isCore] } {
      continue
    }
    $inst setPlacementStatus NONE
    incr n
  }
  return $n
}

# HPWL in microns over signal nets with at least two terminals.
proc mcp_hpwl { } {
  set block [ord::get_db_block]
  set dbu [$block getDbUnitsPerMicron]
  set total 0
  foreach net [$block getNets] {
    if { [$net isSpecial] } {
      continue
    }
    set sig [$net getSigType]
    if { $sig == "POWER" || $sig == "GROUND" } {
      continue
    }
    if { [llength [$net getITerms]] + [llength [$net getBTerms]] < 2 } {
      continue
    }
    set bbox [$net getTermBBox]
    set total [expr { $total + [$bbox dx] + [$bbox dy] }]
  }
  return [expr { double($total) / $dbu }]
}

proc mcp_seconds { } {
  return [expr { [clock milliseconds] / 1000.0 }]
}

# Writes a flat Tcl dict as a JSON object.  Values that look like numbers
# are written as numbers, everything else as strings.
proc mcp_write_json { file dict } {
  set out [open $file w]
  puts $out "\{"
  set first 1
  dict for {key value} $dict {
    if { !$first } {
      puts $out ","
    }
    set first 0
    if { [string is double -strict $value] } {
      puts -nonewline $out "  \"$key\": $value"
    } else {
      set value [string map {\\ \\\\ \" \\\"} $value]
      puts -nonewline $out "  \"$key\": \"$value\""
    }
  }
  puts $out "\n\}"
  close $out
}

# Evaluation shared by every placement variant: legalize, check, global
# route, parasitics, timing.  Returns a dict of metrics.  The global
# route wirelength and overflow are taken from the -metrics file and the
# log of this openroad run (bench/collect.py merges them).
proc mcp_eval { } {
  set t0 [mcp_seconds]
  # ::mcp_eval_base: run identification set by mcp_run_variant, so that the
  # partial file written before routing is complete for bench/collect.py.
  set result [expr { [info exists ::mcp_eval_base] ? $::mcp_eval_base : [dict create] }]
  dict set result hpwl_global_um [format %.1f [mcp_hpwl]]

  set_placement_padding -global -left $::detail_place_pad \
    -right $::detail_place_pad
  # MCP_DPL_DIAMOND=1 selects dpl's diamond-search legalizer instead of the
  # default negotiation legalizer, which does not converge on the ICCAD04
  # conversions (X5: 7-24 overlaps left on gpl and mcp placements alike,
  # check_placement fails); the diamond legalizer legalizes them fully.
  if { [mcp_env MCP_DPL_DIAMOND 0] } {
    detailed_placement -use_diamond_legalizer
  } else {
    detailed_placement
  }
  check_placement -verbose
  dict set result hpwl_um [format %.1f [mcp_hpwl]]
  dict set result t_dpl_s [format %.2f [expr { [mcp_seconds] - $t0 }]]
  # MCP_DEF_OUT=<file>: save the legal placement whose HPWL is the primary
  # metric (after detailed_placement, before DPO) as a DEF, for the
  # solution archive (exp/run.sh --keep-def).
  set def_out [mcp_env MCP_DEF_OUT ""]
  if { $def_out != "" } {
    write_def $def_out
    puts "placement written to $def_out"
  }

  # MCP_DPO=1 adds dpl's detailed placement optimization (independent set
  # matching, global and vertical swaps, reordering, random moves; the
  # ORFS flow runs it after detailed_placement) before routing.  hpwl_um
  # is then the HPWL after it and hpwl_dpl_um the one before.
  if { [mcp_env MCP_DPO 0] } {
    set t_dpo [mcp_seconds]
    dict set result hpwl_dpl_um [dict get $result hpwl_um]
    improve_placement -random_seed [mcp_env MCP_SEED 1]
    check_placement -verbose
    dict set result hpwl_um [format %.1f [mcp_hpwl]]
    dict set result t_dpo_s [format %.2f [expr { [mcp_seconds] - $t_dpo }]]
  }

  # The placement metrics are saved before routing: global_route runs out
  # of memory or crashes on the extreme-aspect k-row floorplans (E17, a
  # 1-row jpeg is 100 mm x 12.6 um), and the placement result should
  # survive that.  mcp_run_variant rewrites the file with everything.
  if { [mcp_env MCP_OUT ""] != "" } {
    set partial $result
    dict set partial routing "not run"
    mcp_write_json [mcp_env MCP_OUT ""].eval.json $partial
  }
  # MCP_NO_ROUTE=1 stops here (placement metrics only): for floorplans whose
  # global_route is known to exhaust memory (E17: 1-2-row swerv / cva6).
  if { [mcp_env MCP_NO_ROUTE 0] } {
    dict set result routing "skipped (MCP_NO_ROUTE)"
    dict set result t_eval_s [format %.2f [expr { [mcp_seconds] - $t0 }]]
    return $result
  }

  set t1 [mcp_seconds]
  foreach adj $::global_routing_layer_adjustments {
    lassign $adj layer adjustment
    set_global_routing_layer_adjustment $layer $adjustment
  }
  set_routing_layers -signal $::global_routing_layers \
    -clock $::global_routing_clock_layers
  set_macro_extension 2
  if { [catch {
    global_route -allow_congestion -congestion_iterations 30 -verbose
  } err] } {
    puts "global_route failed: $err"
    dict set result routing "failed: $err"
    dict set result t_eval_s [format %.2f [expr { [mcp_seconds] - $t0 }]]
    return $result
  }
  dict set result t_grt_s [format %.2f [expr { [mcp_seconds] - $t1 }]]

  estimate_parasitics -global_routing
  dict set result wns_ns [format %.4f [sta::worst_slack -max]]
  dict set result tns_ns [format %.4f [sta::total_negative_slack -max]]
  report_worst_slack -max -digits 3
  report_tns -digits 3
  dict set result t_eval_s [format %.2f [expr { [mcp_seconds] - $t0 }]]
  return $result
}

# Places the design with the variant selected by MCP_VARIANT, saves the
# placed database and the evaluation.  Used by gpl_baseline.tcl and
# mincut.tcl; MCP_OUT is the output prefix.
proc mcp_run_variant { design variant seed place_script } {
  set out [mcp_env MCP_OUT ""]
  if { $out == "" } {
    puts "MCP_OUT (output prefix) is not set"
    exit 1
  }
  mcp_load_design $design
  set_thread_count [mcp_env MCP_THREADS 1]

  set t0 [mcp_seconds]
  uplevel #0 $place_script
  set t_place [expr { [mcp_seconds] - $t0 }]

  # MCP_DB_OUT lets the runner keep databases on scratch, off NFS.
  write_db [mcp_env MCP_DB_OUT ${out}.db]
  set ::mcp_eval_base [dict create design $design variant $variant seed $seed \
    threads [mcp_env MCP_THREADS 1] t_place_s [format %.2f $t_place] \
    git_sha [mcp_git_sha]]
  set result [mcp_eval]
  mcp_write_json ${out}.eval.json $result
  puts "evaluation written to ${out}.eval.json"
}

proc mcp_git_sha { } {
  if { [catch {exec git -C $::mcp_root_dir rev-parse --short HEAD} sha] } {
    return "unknown"
  }
  return $sha
}

# Loads cell positions from a .pl written by exp/fold.py (E27): lines
# "<inst> <x> <y> : <N|FN>" with x, y in dbu (lower-left corner).  N/FN
# only say whether the cell's chunk was mirrored; the orientation set is
# that of the row the cell lands in (R0 or MX), composed with MY when
# mirrored.  Used by bench/pl_place.tcl (evaluate a folded placement) and
# bench/mincut.tcl MCP_PRE=pl:<file> (folded placement as the seed).
proc mcp_pl_import { file } {
  set block [ord::get_db_block]
  # row orientation by y
  set rows [dict create]
  foreach row [$block getRows] {
    dict set rows [[$row getBBox] yMin] [$row getOrient]
  }
  set f [open $file r]
  set n 0
  set missing 0
  set norow 0
  while { [gets $f line] >= 0 } {
    set line [string trim $line]
    if { $line == "" || [string index $line 0] == "#" || [string match "UCLA*" $line] } {
      continue
    }
    set tokens [split [regsub -all {\s+} $line " "] " "]
    lassign $tokens name x y colon flag
    set inst [$block findInst $name]
    if { $inst == "NULL" } {
      incr missing
      continue
    }
    if { [dict exists $rows $y] } {
      set orient [dict get $rows $y]
    } else {
      incr norow
      set orient R0
    }
    if { $flag == "FN" } {
      set orient [expr { $orient == "R0" ? "MY" : "R180" }]
    }
    $inst setOrient $orient
    $inst setLocation [expr { int($x) }] [expr { int($y) }]
    $inst setPlacementStatus PLACED
    incr n
  }
  close $f
  puts "mcp_pl_import: $n cells placed from [file tail $file], $missing unknown names, $norow off-row"
  if { $n != [llength [$block getInsts]] } {
    puts "mcp_pl_import: the file places $n of [llength [$block getInsts]] instances"
  }
}
