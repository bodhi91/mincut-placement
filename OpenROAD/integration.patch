+// --------------------------------------------------------------------------
+// Direct k-way FM refinement under a per-net cost vector instead of the cut
+// metric.  The hypergraph must carry NetVectors: the cost of a solution is
+//   sum_e net[e][mask_e] + sum_v vertex[v][part_v].
+// The gain model and the widened candidate set live in Refiner (see
+// Refiner::CalculateVertexGain), so the pair-wise and greedy refiners
+// optimize the same objective; this class only adds, under debug group
+// "netvector", a check that the gain accumulated by a pass equals the
+// change of Cost().  The pass structure, gain buckets, corking handling
+// and the hard balance bounds are those of KWayFMRefine.
+// --------------------------------------------------------------------------
+class NetVectorRefine : public KWayFMRefine
+{
+ public:
+  NetVectorRefine(int num_parts,
+                  int refiner_iters,
+                  int max_move,
+                  int total_corking_passes,
+                  EvaluatorPtr evaluator,
+                  utl::Logger* logger);
+
+  // Cost of a solution under the net vectors of hgraph.
+  float Cost(const HGraphPtr& hgraph, const std::vector<int>& solution) const;
+
+ protected:
+  float Pass(const HGraphPtr& hgraph,
+             const Matrix<float>& upper_block_balance,
+             const Matrix<float>& lower_block_balance,
+             Matrix<float>& block_balance,
+             Matrix<int>& net_degs,
+             std::vector<float>& cur_paths_cost,
+             Partitions& solution,
+             std::vector<bool>& visited_vertices_flag) override;
+};
+
+}  // namespace par
