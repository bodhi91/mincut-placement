+
+// Net-vector gain of moving v from `from_pid` to `to_pid`; `degs(e)` must
+// return the current per-block degrees of hyperedge e.  The vertex term
+// (vertex[v][from] - vertex[v][to]) is not included.
+template <typename NetDegrees>
+double NetVectorMoveGain(const NetVectors& vectors,
+                         const HGraphPtr& hgraph,
+                         int num_parts,
+                         int v,
+                         int from_pid,
+                         int to_pid,
+                         const NetDegrees& degs)
+{
+  double gain = 0.0;
+  for (const int e : hgraph->Edges(v)) {
+    const auto& deg = degs(e);
+    int mask = 0;
+    for (int q = 0; q < num_parts; q++) {
+      if (deg[q] > 0) {
+        mask |= 1 << q;
+      }
+    }
+    int new_mask = mask | (1 << to_pid);
+    if (deg[from_pid] == 1) {
+      new_mask &= ~(1 << from_pid);
+    }
+    if (new_mask != mask) {
+      gain += vectors.NetCost(e, mask) - vectors.NetCost(e, new_mask);
+    }
+  }
+  return gain;
+}
+
+// Vertices that can gain under the net vectors: those on a cut hyperedge
+// (as for the cut objective), on a hyperedge whose single-block costs
+// differ (an external pull: moving the whole net changes its cost), or
+// with a non-constant vertex vector.  Other vertices can only lose by
+// moving, exactly like interior vertices under the cut objective.
+std::vector<bool> NetVectorLiveVertices(const HGraphPtr& hgraph,
+                                        const Matrix<int>& net_degs,
+                                        int num_parts)
+{
+  const NetVectors& vectors = *hgraph->GetNetVectors();
+  std::vector<bool> live(hgraph->GetNumVertices(), false);
+  for (int e = 0; e < hgraph->GetNumHyperedges(); e++) {
+    bool hot = false;
+    int blocks = 0;
+    for (int q = 0; q < num_parts; q++) {
+      if (net_degs[e][q] > 0) {
+        blocks++;
+      }
+    }
+    if (blocks >= 2) {
+      hot = true;
+    } else {
+      const float c0 = vectors.NetCost(e, 1);
+      for (int q = 1; q < num_parts && !hot; q++) {
+        hot = vectors.NetCost(e, 1 << q) != c0;
+      }
+    }
+    if (hot) {
+      for (const int v : hgraph->Vertices(e)) {
+        live[v] = true;
+      }
+    }
+  }
+  if (vectors.HasVertexCost()) {
+    for (int v = 0; v < hgraph->GetNumVertices(); v++) {
+      if (live[v]) {
+        continue;
+      }
+      const float c0 = vectors.VertexCost(v, 0);
+      for (int q = 1; q < num_parts; q++) {
+        if (vectors.VertexCost(v, q) != c0) {
+          live[v] = true;
+          break;
+        }
+      }
+    }
+  }
+  return live;
+}
