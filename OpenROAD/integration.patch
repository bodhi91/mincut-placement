+// SPDX-License-Identifier: BSD-3-Clause
+// Copyright (c) 2022-2025, The OpenROAD Authors
+
+#pragma once
+
+#include <memory>
+#include <vector>
+
+namespace par {
+
+// Geometric cost vectors for a k-way partitioning problem.  The cost of a
+// solution is sum_e net[e][mask_e] + sum_v vertex[v][part_v], where mask_e
+// has bit q set when hyperedge e has a vertex in block q.  The vectors are
+// an optional side table of a Hypergraph; during coarsening parallel
+// hyperedges add their vectors and hyperedges that fall inside a cluster
+// fold into that cluster's vertex vector.  Used by NetVectorRefine.
+struct NetVectors
+{
+  int num_parts = 0;
+  int num_masks = 0;          // 1 << num_parts
+  std::vector<float> net;     // [e * num_masks + mask]; entry 0 is unused
+  std::vector<float> vertex;  // [v * num_parts + q]; may be empty
+
+  float NetCost(int e, int mask) const { return net[e * num_masks + mask]; }
+  bool HasVertexCost() const { return !vertex.empty(); }
+  float VertexCost(int v, int q) const { return vertex[v * num_parts + q]; }
+};
+using NetVectorsPtr = std::shared_ptr<const NetVectors>;
+
+}  // namespace par
