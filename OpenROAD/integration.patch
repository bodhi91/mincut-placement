 // calculate the statistics of a given partitioning solution
 // PartitionToken.first is the cutsize
 // PartitionToken.second is the balance constraint
+float GoldenEvaluator::CalculateNetVectorCost(
+    const HGraphPtr& hgraph,
+    const std::vector<int>& solution) const
+{
+  const NetVectors* vectors = hgraph->GetNetVectors();
+  if (vectors == nullptr) {
+    return 0.0f;
+  }
+  double cost = 0.0;
+  for (int e = 0; e < hgraph->GetNumHyperedges(); e++) {
+    int mask = 0;
+    for (const int v : hgraph->Vertices(e)) {
+      if (solution[v] >= 0) {
+        mask |= 1 << solution[v];
+      }
+    }
+    if (mask != 0) {
+      cost += vectors->NetCost(e, mask);
+    }
+  }
+  if (vectors->HasVertexCost()) {
+    for (int v = 0; v < hgraph->GetNumVertices(); v++) {
+      if (solution[v] >= 0) {
+        cost += vectors->VertexCost(v, solution[v]);
+      }
+    }
+  }
+  return static_cast<float>(cost);
+}
