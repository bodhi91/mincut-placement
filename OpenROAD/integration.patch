+namespace par {
+
+using utl::PAR;
+
+NetVectorRefine::NetVectorRefine(const int num_parts,
+                                 const int refiner_iters,
+                                 const int max_move,
+                                 const int total_corking_passes,
+                                 EvaluatorPtr evaluator,
+                                 utl::Logger* logger)
+    : KWayFMRefine(num_parts,
+                   refiner_iters,
+                   /* path_wt_factor */ 0.0f,
+                   /* snaking_wt_factor */ 0.0f,
+                   max_move,
+                   total_corking_passes,
+                   std::move(evaluator),
+                   logger)
+{
+}
+
+float NetVectorRefine::Cost(const HGraphPtr& hgraph,
+                            const std::vector<int>& solution) const
+{
+  return evaluator_->CalculateNetVectorCost(hgraph, solution);
+}
+
+float NetVectorRefine::Pass(const HGraphPtr& hgraph,
+                            const Matrix<float>& upper_block_balance,
+                            const Matrix<float>& lower_block_balance,
+                            Matrix<float>& block_balance,
+                            Matrix<int>& net_degs,
+                            std::vector<float>& cur_paths_cost,
+                            Partitions& solution,
+                            std::vector<bool>& visited_vertices_flag)
+{
+  const bool check = logger_->debugCheck(PAR, "netvector", 1);
+  const float before = check ? Cost(hgraph, solution) : 0.0f;
+  const float gain = KWayFMRefine::Pass(hgraph,
+                                        upper_block_balance,
+                                        lower_block_balance,
+                                        block_balance,
+                                        net_degs,
+                                        cur_paths_cost,
+                                        solution,
+                                        visited_vertices_flag);
+  if (check && gain > -std::numeric_limits<float>::max()) {
+    const float after = Cost(hgraph, solution);
+    const float tolerance = 1e-3f * std::max(1.0f, std::abs(before));
+    if (std::abs((before - after) - gain) > tolerance) {
+      logger_->warn(PAR,
+                    928,
+                    "NetVectorRefine pass: cost {} -> {} but gain {}",
+                    before,
+                    after,
+                    gain);
+    } else {
+      debugPrint(logger_,
+                 PAR,
+                 "netvector",
+                 1,
+                 "NetVectorRefine pass: cost {} -> {} (gain {})",
+                 before,
+                 after,
+                 gain);
+    }
+  }
+  return gain;
+}
+
+}  // namespace par
